# Copy to .env and fill in. Never commit .env. All values below are placeholders.

APP_NAME="NFC Affiliates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# URL of the web app used in emailed links. Same as APP_URL when the SPA is served by Laravel.
FRONTEND_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8. Use a dedicated least-privilege user, never root, in production.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nfc_affiliate
DB_USERNAME=nfc_affiliate
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Hosts allowed to authenticate with the Sanctum session cookie (comma separated, include port locally).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Lifetime of mobile/API tokens in minutes (default 30 days).
SANCTUM_EXPIRATION=43200
# Comma separated proxy IPs/CIDRs in front of the app (load balancer), or * behind a trusted proxy only.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes emails to storage/logs locally. Use smtp (or a provider) in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Affiliate programme defaults (see config/affiliate.php)
AFFILIATE_BUSINESS_TIMEZONE=Asia/Kathmandu
AFFILIATE_CURRENCY=NPR
AFFILIATE_ATTRIBUTION_POLICY=last_click
AFFILIATE_ATTRIBUTION_WINDOW_DAYS=30
AFFILIATE_HOLDING_PERIOD_DAYS=14
AFFILIATE_PAYOUT_MINIMUM_MINOR=100000
AFFILIATE_PAYOUT_REQUIRE_SEPARATE_PAYER=false
AFFILIATE_CLICK_RETENTION_DAYS=395
AFFILIATE_MARKETING_MAX_UPLOAD_KB=20480
# Fraud flag thresholds (staff review only; nothing is blocked automatically).
# Amounts are in paisa: 1000000 = NPR 10,000.
AFFILIATE_FRAUD_CONVERSION_MAX_PERCENT=30
AFFILIATE_FRAUD_CONVERSION_MIN_ORDERS=5
AFFILIATE_FRAUD_CLICKS_WITHOUT_ORDERS=1000
AFFILIATE_FRAUD_REFUND_RATE_MAX_PERCENT=30
AFFILIATE_FRAUD_REFUND_RATE_MIN_ORDERS=5
AFFILIATE_FRAUD_EARNINGS_SPIKE_MULTIPLE=5
AFFILIATE_FRAUD_EARNINGS_SPIKE_MIN_MINOR=1000000
AFFILIATE_FRAUD_LARGE_PAYOUT_MINOR=5000000
AFFILIATE_FRAUD_DETAIL_CHANGE_DAYS=7
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5

VITE_APP_NAME="${APP_NAME}"

# Online payments (ADR 0011). Leave disabled until the merchant account is ready.
# Sandbox mode is refused when APP_ENV=production.
ESEWA_ENABLED=false
ESEWA_MODE=sandbox
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
KHALTI_ENABLED=false
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=
